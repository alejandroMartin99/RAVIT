{
  "source": "pd",
  "label": "Program Directive",
  "file": {
    "extensions": [".xlsx", ".xlsm"],
    "max_bytes": 10485760
  },
  "sheet": {
    "name": "PD-SUMMARY",
    "header_row": 1
  },
  "columns": [
    {
      "id": "item_ref",
      "header": "Item Ref,",
      "aliases": ["ITEM REF"],
      "required": true,
      "allow_empty": false,
      "unique": true
    },
    {
      "id": "scope_comitee_id",
      "header": "SCOPE COMITEE ID",
      "aliases": ["Scope Comitee ID"],
      "required": true,
      "allow_empty": false,
      "unique": true
    },
    {
      "id": "document_type",
      "header": "DOCUMENT TYPE",
      "aliases": ["Document Type", " Type"],
      "required": true,
      "allow_empty": false,
      "pad": 2
    },
    {
      "id": "task_reference",
      "header": "TASK REFERENCE",
      "aliases": ["Task Reference", "PD Reference"],
      "required": true,
      "allow_empty": false
    },
    {
      "id": "revision",
      "header": "REVISION",
      "aliases": ["Revision", "Revision PD"],
      "required": true,
      "allow_empty": true
    },
    {
      "id": "description",
      "header": "DESCRIPTION",
      "aliases": ["Description", "Title", "TITLE"],
      "required": true,
      "allow_empty": false,
      "min_length": 3
    },
    {
      "id": "pn",
      "header": "PN",
      "aliases": ["pn", "pnr"],
      "required": true,
      "allow_empty": true
    },
    {
      "id": "sn",
      "header": "SN",
      "aliases": ["snr"],
      "required": true,
      "allow_empty": true
    },
    {
      "id": "fin_position",
      "header": "FIN/POSITION",
      "aliases": ["FIN/POSITION"],
      "required": true,
      "allow_empty": true
    },
    {
      "id": "source_material",
      "header": "SOURCE MATERIAL",
      "aliases": ["Source material"],
      "required": true,
      "allow_empty": false
    },
    {
      "id": "source_hours",
      "header": "SOURCE HOURS",
      "aliases": ["Source hours", "MH", "Manhours", "Hours"],
      "required": true,
      "allow_empty": false
    },
    {
      "id": "pd_comment",
      "header": "PD COMMENT",
      "aliases": ["PD comment"],
      "required": true,
      "allow_empty": true
    }
    
    
  ],
  "issue_number": {
    "header_pattern": "^[0-9]{1,2}\\.[0-9]{2}$",
    "allow_empty": false,
    "enum": ["Y", "OUT","UNDER REVIEW"]
  },
  "checks": [
    { "id": "issue_name", "label": "Issue XX.XX detected from filename" },
    { "id": "source", "label": "Source file received", "silent": true },
    { "id": "format", "label": "Excel workbook format", "silent": true },
    { "id": "workbook", "label": "Workbook can be opened", "silent": true },
    { "id": "sheet", "label": "Workbook has a PD-SUMMARY sheet", "silent": true },
    { "id": "issue_version", "label": "Column XX.XX is present" },
    { "id": "issue_number", "label": "Column XX.XX values are Y / OUT / UNDER REVIEW" },
    { "id": "headers", "label": "Required columns are present" },
    { "id": "empty", "label": "Required cells are not empty" },
    { "id": "values", "label": "Column formats are valid" },
    { "id": "flags", "label": "Applicability flags Y / OUT are sequential" },
    { "id": "unique", "label": "ITEM REF and SCOPE COMITEE ID are unique" },
    { "id": "unique_line", "label": "Reference, revision, FIN, PNR, SNR and column XX.XX are unique" },
    { "id": "store", "label": "Issue stored in the aircraft PD folder" }
  ]
}
